    },
    {
      "id": "audacity",
      "name": "Audacity — Voice Studio",
      "kind": "desktop",
      "category": "Studio",
      "icon": "🎙️",
      "desc": "Voice studio: record, cut, master audio",
      "exec": [
        "audacity"
      ],
      "stop_pattern": "audacity",
