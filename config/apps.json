      "desc": "Speech to text CLI (vrtx-stt/whisper-cli) — agent transcription",
      "cmd": "~/vrtx-stt/bin/whisper-cli",
      "gated": true
    },
    {
      "id": "zcode",
      "name": "ZCode",
      "kind": "desktop",
      "category": "AI App",
      "icon": "⚡",
      "desc": "ZCode desktop",
      "exec": [
        "/opt/ZCode/zcode"
      ],
      "stop_pattern": "/opt/ZCode/zcode",
      "gated": false
    },
    {
      "id": "connector-gmail",
      "name": "Gmail",
      "kind": "connector",
      "category": "Connectors",
      "icon": "✉️",
      "desc": "Mail automation via Gmail API — needs OAuth setup (see docs/awesome-repos.md)",
      "configured": false,
      "setup_docs": "docs/awesome-repos.md#connectors",
      "gated": true
    },
    {
      "id": "connector-youtube",
      "name": "YouTube",
      "kind": "connector",
      "category": "Connectors",
      "icon": "📺",
      "desc": "Upload / analytics automation via YouTube Data API — needs API key",
      "configured": false,
      "setup_docs": "docs/awesome-repos.md#connectors",
      "gated": true
    },
    {
      "id": "connector-instagram",
      "name": "Instagram",
      "kind": "connector",
      "category": "Connectors",
      "icon": "📸",
      "desc": "Posting / DM automation — needs API or session setup",
      "configured": false,
      "setup_docs": "docs/awesome-repos.md#connectors",
      "gated": true
    },
    {
      "id": "speaches",
      "name": "speaches (TTS+STT)",
      "kind": "service",
      "category": "AI Engine",
      "icon": "🎙️",
      "desc": "One CPU podman container: Kokoro TTS (/v1/audio/speech) + faster-whisper STT (/v1/audio/transcriptions) on :8000 — GPU stays with bonsai",
      "check": {
        "type": "tcp",
        "target": "http://127.0.0.1:8000"
      },
      "start": "podman start speaches-stt 2>/dev/null || podman run -i --name speaches-stt -p 127.0.0.1:8000:8000 ghcr.io/speaches-ai/speaches:latest-cpu",
      "stop_pattern": "speaches-stt",
      "gated": false
    }
  ]
}