{
  "apps": [
    {
      "id": "ollama",
      "name": "Ollama",
      "kind": "service",
      "category": "AI Engine",
      "icon": "🦙",
      "desc": "Tower PRIMARY — local chat/coding models",
      "check": {
        "type": "tcp",
        "target": "http://127.0.0.1:11434"
      },
      "start": "systemctl start ollama",
      "stop_pattern": "ollama serve",
      "gated": false
    },
    {
      "id": "localai",
      "name": "LocalAI",
      "kind": "service",
      "category": "AI Engine",
      "icon": "🔷",
      "desc": "Tower SPECIALTY — bonsai 27B, voice (voxcpm2), video (wan-2.1), 43 MCP tools",
      "check": {
        "type": "tcp",
        "target": "http://127.0.0.1:8080"
      },
      "cwd": "./localai",
      "start": "cd ./localai && nohup ./local-ai run --address 127.0.0.1:8080 >> localai.log 2>&1 &",
      "stop_pattern": "local-ai run --address 127.0.0.1:8080",
      "gated": false
    },
    {
      "id": "needle",
      "name": "Needle 3",
      "kind": "service",
      "category": "AI Engine",
      "icon": "🪡",
      "desc": "121M on-device tool-calling model — the agent's fast tool router (port 8088)",
      "check": {
        "type": "tcp",
        "target": "http://127.0.0.1:8088"
      },
      "cwd": "~/needle3",
      "start": "cd ~/needle3 && nohup ./needle --model needle3.cact --tools ./config/needle-tools.json --serve --port 8088 >> ./logs/needle.log 2>&1 &",
      "stop_pattern": "needle --model needle3.cact --serve",
      "gated": false
    },
    {
      "id": "brain",
      "name": "VRTX-BRAIN Console",
      "kind": "service",
      "category": "Brain",
      "icon": "🧠",
      "desc": "The brain's console server (MCP tools) on :8420",
      "check": {
        "type": "tcp",
        "target": "http://127.0.0.1:8420"
      },
      "start": "~/VRTX-BRAIN/bin/vrtx-brain",
      "stop_pattern": "console.app",
      "gated": true
    },
    {
      "id": "jan",
      "name": "Jan",
      "kind": "desktop",
      "category": "AI App",
      "icon": "💬",
      "desc": "Local AI chat app — point it at the tower endpoint",
      "exec": [
        "~/apps/jan/jan.AppImage"
      ],
      "stop_pattern": "jan.AppImage",
      "gated": false
    },
    {
      "id": "dyad",
      "name": "Dyad",
      "kind": "desktop",
      "category": "AI App",
      "icon": "🌊",
      "desc": "AI app builder",
      "exec": [
        "~/apps/dyad/dyad.AppImage"
      ],
      "stop_pattern": "dyad.AppImage",
      "gated": false
    },
    {
      "id": "browseros",
      "name": "BrowserOS",
      "kind": "desktop",
      "category": "Browser",
      "icon": "🌐",
      "desc": "AI browser — the agent's eyes for web tasks",
      "exec": [
        "~/apps/browseros/browseros.AppImage"
      ],
      "stop_pattern": "browseros",
      "gated": false
    },
    {
      "id": "ruhi",
      "name": "Ruhi",
      "kind": "desktop",
      "category": "AI App",
      "icon": "🌸",
      "desc": "Private local AI companion, tutor and coder",
      "exec": [
        "~/ruhi/launcher"
      ],
      "stop_pattern": "ai-brains/ruhi",
      "gated": false
    },
    {
      "id": "gimp",
      "name": "GIMP — Photo Studio",
